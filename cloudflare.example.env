# Every __NAME__ placeholder used in the source is listed here. Copy this file
# to .cloudflare.env, fill in your own values and deploy with:
#   sh tools/deploy.sh .cloudflare.env
# Empty values are allowed; routes whose pattern ends up empty are dropped.
PUBLIC_HOST=terms.example.com
ALIAS_HOST=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=terms.example.com
D1_DATABASE_NAME=plainword
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
THEME_KEY_PREFIX=plainword
THEME_COOKIE_DOMAIN=
SITE_FAMILY=Example
RELATED_SITE_HTML=
