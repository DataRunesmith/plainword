{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plainword",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "__PUBLIC_HOST__",
      "custom_domain": true
    },
    {
      "pattern": "__ALIAS_HOST__",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "__TURNSTILE_HOSTNAMES__"
  }
}
