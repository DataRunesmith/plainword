{
  "name": "plainword",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plainword",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
